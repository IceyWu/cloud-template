{
  "extends": ["ultracite/biome/core", "ultracite/biome/vue"],
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "src/**",
      "mock/**",
      "presets/**",
      "!src/style",
      "!src/assets"
    ],
    "ignoreUnknown": true
  },
  "linter": {
    "rules": {
      "suspicious": {
        "noExplicitAny": "off",
        "noEvolvingTypes": "off",
        "noDuplicateProperties": "off",
        "noDuplicateCustomProperties": "off",
        "noEmptyBlockStatements": "off",
        "noEmptySource": "off",
        "useAwait": "warn",
        "noUnnecessaryConditions": "off"
      },
      "correctness": {
        "noUnusedVariables": "off",
        "noUndeclaredVariables": "off",
        "noUnusedImports": "off",
        "noUnusedFunctionParameters": "off",
        "noUnusedPrivateClassMembers": "off"
      },
      "style": {
        "useConsistentTypeDefinitions": "off",
        "useFilenamingConvention": "off",
        "useBlockStatements": "off",
        "noNonNullAssertion": "warn",
        "noParameterAssign": "off",
        "useForOf": "off",
        "noNestedTernary": "off",
        "noExportedImports": "off",
        "useConsistentMemberAccessibility": "off",
        "noIncrementDecrement": "off",
        "useReadonlyClassProperties": "off",
        "useConsistentMethodSignatures": "off",
        "useDestructuring": "off",
        "useVueMultiWordComponentNames": "off"
      },
      "complexity": {
        "noRedundantDefaultExport": "off",
        "noExcessiveCognitiveComplexity": "off",
        "noForEach": "off"
      },
      "performance": {
        "noBarrelFile": "off",
        "useTopLevelRegex": "off"
      },
    }
  },
  "overrides": [
    {
      "includes": ["src/assets/**"],
      "linter": {
        "enabled": false
      },
      "formatter": {
        "enabled": false
      }
    },
    {
      "includes": ["src/style/**"],
      "linter": {
        "enabled": false
      },
      "formatter": {
        "enabled": false
      }
    },
    {
      "includes": ["src/components/ui/**"],
      "linter": {
        "enabled": false
      },
      "formatter": {
        "enabled": false
      }
    },
  ],
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  }
}
